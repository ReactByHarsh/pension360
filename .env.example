# Local fictional-data demonstration only. Copy to .env and choose a strong URL-safe password.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
NODE_ENV=development
PORT=4000
API_HOST=127.0.0.1
DATABASE_URL=postgres://pension360:replace-with-a-long-random-url-safe-password@127.0.0.1:5432/pension360
# Default app provider is OpenAI. Without these values, AI returns a clear configuration error.
AI_PROVIDER=openai
OPENAI_MODEL=
OPENAI_API_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_SCAN_URL=
DOCUMENT_SCAN_TOKEN=
DEV_AUTH_SECRET=replace-this-with-a-long-random-development-secret
SOURCE_ALLOWED_ORIGINS=http://127.0.0.1:4000
SOURCE_ALLOW_PRIVATE_ORIGINS=http://127.0.0.1:4000
SOURCE_ALLOW_HTTP_ORIGINS=http://127.0.0.1:4000
SOURCE_CREDENTIAL_REFS=
SOURCE_TIMEOUT_MS=10000
TRUST_PROXY=false
