<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ReadinessReview" targetNamespace="https://pension360.example/workflows">
<bpmn:process id="ReadinessReview" name="ReadinessReview" isExecutable="true">
<bpmn:startEvent id="Start" name="Start readiness review"><bpmn:outgoing>StartAssessment</bpmn:outgoing></bpmn:startEvent>
<bpmn:businessRuleTask id="AssessRule" name="Run readiness rule"><bpmn:incoming>StartAssessment</bpmn:incoming><bpmn:outgoing>AssessmentResult</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="StatusGateway" name="Ready for review?" default="NeedsEvidence"><bpmn:incoming>AssessmentResult</bpmn:incoming><bpmn:outgoing>Ready</bpmn:outgoing><bpmn:outgoing>NeedsEvidence</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="EvidenceTask" name="Request missing or conflicting evidence"><bpmn:incoming>NeedsEvidence</bpmn:incoming><bpmn:outgoing>EvidenceComplete</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="EvidenceEnd" name="Evidence follow-up required"><bpmn:incoming>EvidenceComplete</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="ReviewTask" name="Independent readiness review"><bpmn:incoming>Ready</bpmn:incoming><bpmn:outgoing>ReviewComplete</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="ReviewGateway" name="Review approved?" default="Reject"><bpmn:incoming>ReviewComplete</bpmn:incoming><bpmn:outgoing>Approve</bpmn:outgoing><bpmn:outgoing>Reject</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="ApprovedEnd" name="Readiness review approved"><bpmn:incoming>Approve</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="RejectedEnd" name="Returned for evidence"><bpmn:incoming>Reject</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="StartAssessment" sourceRef="Start" targetRef="AssessRule"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="AssessmentResult" sourceRef="AssessRule" targetRef="StatusGateway"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Ready" sourceRef="StatusGateway" targetRef="ReviewTask"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[{"path":"rule.status","operator":"eq","value":"READY_FOR_REVIEW"}]]></bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="NeedsEvidence" sourceRef="StatusGateway" targetRef="EvidenceTask"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="EvidenceComplete" sourceRef="EvidenceTask" targetRef="EvidenceEnd"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="ReviewComplete" sourceRef="ReviewTask" targetRef="ReviewGateway"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Approve" sourceRef="ReviewGateway" targetRef="ApprovedEnd"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[{"path":"tasks.ReviewTask.decision","operator":"eq","value":"APPROVE"}]]></bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Reject" sourceRef="ReviewGateway" targetRef="RejectedEnd"></bpmn:sequenceFlow>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_ReadinessReview"><bpmndi:BPMNPlane id="Plane_ReadinessReview" bpmnElement="ReadinessReview">
<bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start"><dc:Bounds x="80" y="192" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_AssessRule" bpmnElement="AssessRule"><dc:Bounds x="180" y="170" width="140" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_StatusGateway" bpmnElement="StatusGateway"><dc:Bounds x="390" y="185" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_EvidenceTask" bpmnElement="EvidenceTask"><dc:Bounds x="540" y="340" width="140" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_EvidenceEnd" bpmnElement="EvidenceEnd"><dc:Bounds x="770" y="362" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_ReviewTask" bpmnElement="ReviewTask"><dc:Bounds x="540" y="100" width="140" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_ReviewGateway" bpmnElement="ReviewGateway"><dc:Bounds x="770" y="115" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_ApprovedEnd" bpmnElement="ApprovedEnd"><dc:Bounds x="1000" y="42" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_RejectedEnd" bpmnElement="RejectedEnd"><dc:Bounds x="1000" y="222" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="Edge_StartAssessment" bpmnElement="StartAssessment"><di:waypoint x="116" y="210"/><di:waypoint x="180" y="210"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_AssessmentResult" bpmnElement="AssessmentResult"><di:waypoint x="320" y="210"/><di:waypoint x="390" y="210"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_Ready" bpmnElement="Ready"><di:waypoint x="440" y="210"/><di:waypoint x="490" y="210"/><di:waypoint x="490" y="140"/><di:waypoint x="540" y="140"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_NeedsEvidence" bpmnElement="NeedsEvidence"><di:waypoint x="440" y="210"/><di:waypoint x="490" y="210"/><di:waypoint x="490" y="380"/><di:waypoint x="540" y="380"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_EvidenceComplete" bpmnElement="EvidenceComplete"><di:waypoint x="680" y="380"/><di:waypoint x="770" y="380"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_ReviewComplete" bpmnElement="ReviewComplete"><di:waypoint x="680" y="140"/><di:waypoint x="770" y="140"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_Approve" bpmnElement="Approve"><di:waypoint x="820" y="140"/><di:waypoint x="910" y="140"/><di:waypoint x="910" y="60"/><di:waypoint x="1000" y="60"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_Reject" bpmnElement="Reject"><di:waypoint x="820" y="140"/><di:waypoint x="910" y="140"/><di:waypoint x="910" y="240"/><di:waypoint x="1000" y="240"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>
