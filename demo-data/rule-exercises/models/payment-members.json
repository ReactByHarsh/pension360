            {
              "id": "expr-2",
              "key": "reason",
              "value": "abs(proposedBaisa - approvedBaisa - adjustmentBaisa) > toleranceBaisa ? \"Unexplained payment difference requires evidence review\" : \"Payment matches the supplied approval\""
