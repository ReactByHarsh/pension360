NODE_ENV=production
PORT=4000
API_HOST=0.0.0.0
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-bootstrap-password
DATABASE_URL=postgres://pension360_app:REPLACE@postgres:5432/pension360
MIGRATION_DATABASE_URL=postgres://pension360:REPLACE@postgres:5432/pension360
# For remote managed PostgreSQL use TLS with a trusted CA, e.g. sslmode=verify-full.
OIDC_ISSUER=https://identity.example.org/realms/pension360
OIDC_AUDIENCE=pension360-api
OIDC_JWKS_URI=https://identity.example.org/realms/pension360/protocol/openid-connect/certs
VITE_OIDC_AUTHORITY=https://identity.example.org/realms/pension360
VITE_OIDC_CLIENT_ID=pension360-web
VITE_OIDC_REDIRECT_URI=https://pension360.example.org/auth/callback
VITE_OIDC_SCOPE=openid profile pension360
AI_PROVIDER=openai
OPENAI_MODEL=
OPENAI_API_KEY=
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_SCAN_URL=https://scanner.example.org/scan
DOCUMENT_SCAN_TOKEN=
SOURCE_ALLOWED_ORIGINS=https://pension-api.example.org
SOURCE_ALLOW_PRIVATE_ORIGINS=https://pension-api.example.org
SOURCE_ALLOW_HTTP_ORIGINS=
SOURCE_CREDENTIAL_REFS=PENSION_SOURCE_TOKEN
PENSION_SOURCE_TOKEN=
SOURCE_TIMEOUT_MS=10000
TRUST_PROXY=true
# Later offline text provider. No Python service is required by this application.
OFFLINE_LLM_BASE_URL=
OFFLINE_LLM_MODEL=
OFFLINE_LLM_API_KEY=
OFFLINE_LLM_ALLOW_HTTP=false
